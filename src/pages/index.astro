---
// src/pages/index.astro
// 這是一個「轉運站」頁面，用來平滑地將用戶送往對應的語言版本
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ferry Easy</title>
    
    <style>
        /* 🟢 1. 視覺魔術：強制全螢幕深色背景 */
        html, body {
            background-color: #111318; /* 跟你的 App 主題色一致 */
            margin: 0;
            padding: 0;
            height: 100vh;
            width: 100vw;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* 🟢 2. 加個 Loading 動畫，讓等待看起來更專業 */
        .loader {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            border-top-color: #135bec; /* 你的主色調藍色 */
            animation: spin 0.8s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>

    <script>
        // 偵測瀏覽器語言
        const lang = navigator.language.toLowerCase();
        // 如果是中文 (zh-HK, zh-TW, zh-CN...) 去中文版，否則去英文版
        const target = lang.includes('zh') ? '/zh-hk/' : '/en/';
        
        // 使用 replace 而不是 assign，這樣用戶按「上一頁」不會卡在這個跳轉頁
        window.location.replace(target);
    </script>
    
    <noscript>
        <meta http-equiv="refresh" content="0;url=/en/">
    </noscript>
</head>
<body>
    <div class="loader"></div>
</body>
</html>