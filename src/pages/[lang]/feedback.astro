---
// src/pages/[lang]/feedback.astro
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const isEn = lang === 'en';

// 🔙 返回按鈕的連結
const backLink = `/${lang}/`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{isEn ? 'Feedback' : '意見回饋'} | Ferry Easy</title>
    <style>
        body { background-color: #111318; color: white; font-family: system-ui, sans-serif; margin: 0; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { display: flex; align-items: center; margin-bottom: 20px; }
        .back-btn { text-decoration: none; color: #9da6b9; display: flex; align-items: center; gap: 5px; font-size: 0.9rem; }
        iframe { width: 100%; height: 800px; border: none; background: transparent; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <a href={backLink} class="back-btn">
                ← {isEn ? 'Back to Home' : '返回首頁'}
            </a>
        </div>
        
        <h1 style="text-align: center; font-size: 1.5rem; margin-bottom: 1rem;">
            {isEn ? 'We value your feedback' : '我們重視您的意見'}
        </h1>

        <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSc-noWgUFqRPWfTjDvIQ5zBl98FB4qMIviFzBJsFKCTedGcGg/viewform?embedded=true">Loading…</iframe>
    
    </div>
</body>
</html>