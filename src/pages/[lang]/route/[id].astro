---
// src/pages/[lang]/route/[id].astro
import { getRoutes, getSchedules } from '../../../lib/ferryData';
import holidays from '../../../data/holidays.json';
import { ui } from '../../../i18n/ui';

export function getStaticPaths() {
  const routes = getRoutes();
  const paths = [];
  
  routes.forEach(route => {
    paths.push({ params: { lang: 'en', id: route.route_id }, props: { route } });
    paths.push({ params: { lang: 'zh-hk', id: route.route_id }, props: { route } });
  });
  
  return paths;
}

const { route } = Astro.props;
const { lang } = Astro.params;
const t = ui[lang as keyof typeof ui];
const isEn = lang === 'en';

const routeSchedules = getSchedules().filter(s => s.route_id === route.route_id);

const switchLang = isEn ? 'zh-hk' : 'en';
const switchLabel = isEn ? '繁' : 'En';

// 🟢 修正點：在這裡 (Server Side) 先定義好預設變數，HTML 才不會報錯
// 因為伺服器端無法讀取 URL 參數 ?dir=...，所以預設先顯示 Outbound (去程)
// 等頁面載入後，底下的 JavaScript 會再根據 URL 更新成正確的方向
const displayOrigin = isEn ? route.origin_en : route.origin_zh;
const displayDest = isEn ? route.destination_en : route.destination_zh;
---

<!DOCTYPE html>
<html class="dark" lang={lang}>
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>{displayOrigin} {isEn ? 'to' : '往'} {displayDest} | {t['site.title']}</title>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #111318; }
        ::-webkit-scrollbar-thumb { background: #282e39; border-radius: 3px; }
        .hidden-row { display: none !important; }
    </style>
</head>

<body class="font-display bg-[#111318] text-white antialiased min-h-screen pb-10">

    <div id="page-data" 
         data-route={JSON.stringify(route)} 
         data-schedules={JSON.stringify(routeSchedules)}
         data-holidays={JSON.stringify(holidays)} 
         data-lang={lang}
         data-ui={JSON.stringify(t)}
         class="hidden"></div>

    <header class="sticky top-0 z-30 flex flex-col bg-[#111318]/95 backdrop-blur-md border-b border-[#282e39]">
        <div class="flex items-center justify-between px-5 py-4">
            <div class="flex items-center gap-4">
                <a href={`/${lang}/`} class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#282e39] text-[#9da6b9] hover:text-white hover:bg-[#3b4354] transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <div class="flex flex-col">
                    <h1 id="header-title" class="text-white text-lg font-bold leading-tight">
                        {displayOrigin} {isEn ? 'to' : '往'} {displayDest}
                    </h1>
                    <span class="text-[#9da6b9] text-xs">{isEn ? route.operator_en : route.operator_zh}</span>
                </div>
            </div>

            <a id="lang-switch-btn" href="#" class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#282e39] text-[#9da6b9] hover:text-white transition-colors border border-transparent hover:border-[#3b4354] font-bold text-xs">
                {switchLabel}
            </a>
        </div>

        <div class="flex items-center gap-3 px-5 pb-4 overflow-x-auto no-scrollbar">
            <button id="btn-today" class="flex items-center gap-2 px-4 py-2 rounded-full bg-[#135bec] text-white text-sm font-bold border border-[#135bec] shadow-lg shadow-primary/20 transition-all whitespace-nowrap">
                <span class="material-symbols-outlined text-base">calendar_today</span>
                {t['btn.today']}
            </button>
            <div class="relative flex items-center">
                <input type="date" id="date-picker" class="bg-[#1c1f27] text-white text-sm font-medium border border-[#3b4354] rounded-full px-4 py-1.5 focus:outline-none focus:border-[#135bec] focus:ring-1 focus:ring-[#135bec] transition-all"/>
            </div>
            <span id="schedule-status" class="ml-auto text-xs text-[#9da6b9] font-medium whitespace-nowrap">{t['status.loading']}</span>
        </div>
        
        <div class="px-5 pb-2 text-xs text-[#555e70] flex justify-between items-center bg-[#111318]">
            <span>{t['text.direction']} <b id="current-dir-text" class="text-[#9da6b9]">...</b></span>
        </div>
    </header>

    <main class="max-w-[480px] mx-auto p-5 flex flex-col gap-6">

        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#1c1f27] to-[#111318] border border-[#282e39] p-6 shadow-lg">
            <div class="absolute top-0 right-0 -mt-10 -mr-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl"></div>
            
            <div class="relative z-10 flex justify-between items-center">
                <div class="flex flex-col items-center gap-2 w-1/3">
                    <span id="origin-name" class="text-2xl font-bold text-white text-center leading-tight">--</span>
                    <a id="origin-map" href="#" target="_blank" class="flex items-center gap-1 text-[10px] text-blue-400 bg-blue-400/10 px-2 py-0.5 rounded border border-blue-400/20 hover:bg-blue-400/20 transition-colors">
                        <span class="material-symbols-outlined text-[12px]">location_on</span>
                        <span id="origin-pier">--</span>
                    </a>
                </div>

                <div class="flex flex-col items-center justify-center w-1/3 opacity-80">
                    <span class="text-xs text-slate-300 mb-1 font-medium">{route.duration_slow} {t['text.min']}</span>
                    
                    <div class="w-full h-[1px] bg-[#3b4354] relative">
                        <span class="absolute -top-1.5 right-0 text-[#3b4354] text-[10px]">▶</span>
                    </div>
                </div>

                <div class="flex flex-col items-center gap-2 w-1/3">
                    <span id="dest-name" class="text-2xl font-bold text-white text-center leading-tight">--</span>
                    <a id="dest-map" href="#" target="_blank" class="flex items-center gap-1 text-[10px] text-blue-400 bg-blue-400/10 px-2 py-0.5 rounded border border-blue-400/20 hover:bg-blue-400/20 transition-colors">
                        <span class="material-symbols-outlined text-[12px]">location_on</span>
                        <span id="dest-pier">--</span>
                    </a>
                </div>
            </div>
            
            <div class="mt-6 pt-4 border-t border-[#282e39] flex justify-between items-center text-center">
                <div id="fare-weekday" class="flex flex-col w-1/2 transition-opacity duration-300">
                    <span class="text-[#9da6b9] text-[10px] uppercase tracking-wider font-bold">Mon - Sat</span>
                    <span class="text-white text-lg font-bold">${route.fare_slow_weekday}</span>
                </div>
                <div class="h-8 w-px bg-[#282e39]"></div>
                <div id="fare-holiday" class="flex flex-col w-1/2 opacity-40 transition-opacity duration-300">
                    <span class="text-[#9da6b9] text-[10px] uppercase tracking-wider font-bold">Sun & Holiday</span>
                    <span class="text-white text-lg font-bold text-emerald-400">${route.fare_slow_holiday}</span>
                </div>
            </div>
        </div>

        <section>
            <div class="flex items-center justify-between mb-4 px-1">
                <h3 class="text-white text-lg font-bold">{t['header.upcoming']}</h3>
                <span id="filtered-count" class="text-[#555e70] text-xs font-medium">--</span>
            </div>
            <div class="flex flex-col gap-2" id="schedule-list"></div>
        </section>

    </main>

    <script>
        const pageData = document.getElementById('page-data');
        const ROUTE = JSON.parse(pageData.getAttribute('data-route'));
        const ALL_SCHEDULES = JSON.parse(pageData.getAttribute('data-schedules'));
        const HOLIDAYS = new Set(JSON.parse(pageData.getAttribute('data-holidays')));
        const LANG = pageData.getAttribute('data-lang');
        const UI = JSON.parse(pageData.getAttribute('data-ui'));
        const IS_EN = LANG === 'en';

        const switchLang = IS_EN ? 'zh-hk' : 'en';
        const langBtn = document.getElementById('lang-switch-btn');
        langBtn.href = `/${switchLang}/route/${ROUTE.route_id}` + window.location.search;

        const urlParams = new URLSearchParams(window.location.search);
        const CURRENT_DIR = urlParams.get('dir') === 'inbound' ? 'inbound' : 'outbound';

        const originField = IS_EN ? 'origin_en' : 'origin_zh';
        const destField = IS_EN ? 'destination_en' : 'destination_zh';
        const originPierField = IS_EN ? 'origin_pier_en' : 'origin_pier_zh';
        const destPierField = IS_EN ? 'destination_pier_en' : 'destination_pier_zh';
        const remarkField = IS_EN ? 'remark_en' : 'remark_zh';

        const displayOrigin = CURRENT_DIR === 'inbound' ? ROUTE[destField] : ROUTE[originField];
        const displayDest = CURRENT_DIR === 'inbound' ? ROUTE[originField] : ROUTE[destField];
        const displayOriginPier = CURRENT_DIR === 'inbound' ? ROUTE[destPierField] : ROUTE[originPierField];
        const displayDestPier = CURRENT_DIR === 'inbound' ? ROUTE[originPierField] : ROUTE[destPierField];
        const displayOriginMap = CURRENT_DIR === 'inbound' ? (ROUTE.destination_map_url || '#') : (ROUTE.origin_map_url || '#');
        const displayDestMap = CURRENT_DIR === 'inbound' ? (ROUTE.origin_map_url || '#') : (ROUTE.destination_map_url || '#');

        // 🟢 JS 再次更新標題，確保 "往/to" 正確，且方向正確
        const connector = IS_EN ? ' to ' : ' 往 ';
        document.title = `${displayOrigin}${connector}${displayDest} | ${UI['site.title']}`;
        document.getElementById('header-title').innerText = `${displayOrigin}${connector}${displayDest}`;

        document.getElementById('current-dir-text').innerText = CURRENT_DIR.toUpperCase();
        
        document.getElementById('origin-name').innerText = displayOrigin;
        document.getElementById('origin-pier').innerText = displayOriginPier;
        document.getElementById('origin-map').href = displayOriginMap;

        document.getElementById('dest-name').innerText = displayDest;
        document.getElementById('dest-pier').innerText = displayDestPier;
        document.getElementById('dest-map').href = displayDestMap;

        const activeSchedules = ALL_SCHEDULES.filter(s => s.direction === CURRENT_DIR);
        activeSchedules.sort((a, b) => a.time.localeCompare(b.time));

        const btnToday = document.getElementById('btn-today');
        const datePicker = document.getElementById('date-picker');
        const scheduleStatus = document.getElementById('schedule-status');
        const scheduleListContainer = document.getElementById('schedule-list');
        const fareWeekday = document.getElementById('fare-weekday');
        const fareHoliday = document.getElementById('fare-holiday');
        const filteredCount = document.getElementById('filtered-count');

        function getFare(type, dayType) {
            const isHolidayType = dayType.includes('sun') || dayType.includes('ph');
            if (type === 'fast') {
                return isHolidayType ? ROUTE.fare_fast_holiday : ROUTE.fare_fast_weekday;
            } else {
                return isHolidayType ? ROUTE.fare_slow_holiday : ROUTE.fare_slow_weekday;
            }
        }

        function getDayCategory(dateObj) {
            const dateStr = dateObj.toISOString().split('T')[0];
            const day = dateObj.getDay(); 
            const isPh = HOLIDAYS.has(dateStr);
            if (day === 0 || isPh) return 'sun_ph';
            if (day === 6) return 'sat';
            return 'weekday';
        }

        function renderList(category) {
            let html = '';
            let count = 0;

            activeSchedules.forEach(item => {
                let shouldShow = false;
                const rowType = item.day_type;

                if (category === 'sun_ph') {
                    if (rowType === 'sun_ph' || rowType === 'sat_sun_ph') shouldShow = true;
                } else if (category === 'sat') {
                    if (rowType === 'mon_sat' || rowType === 'sat' || rowType === 'sat_sun_ph') shouldShow = true;
                } else {
                    if (rowType === 'mon_sat' || rowType === 'mon_fri') shouldShow = true;
                }

                if (shouldShow) {
                    count++;
                    const fare = getFare(item.type, item.day_type);
                    
                    let tags = '';
                    if (item.day_type === 'mon_fri') tags = `<span class="text-[10px] text-red-400 bg-red-400/10 px-2 py-1 rounded font-bold">${UI['label.mon_fri']}</span>`;
                    else if (item.day_type === 'sat') tags = `<span class="text-[10px] text-orange-400 bg-orange-400/10 px-2 py-1 rounded font-bold">${UI['label.sat']}</span>`;
                    else if (item.day_type === 'sun_ph') tags = `<span class="text-[10px] text-emerald-400 bg-emerald-400/10 px-2 py-1 rounded font-bold">${UI['label.sun_ph']}</span>`;
                    
                    let remarkText = item[remarkField];
                    let remark = remarkText ? `<div class="text-[9px] text-[#9da6b9] mt-1">${remarkText}</div>` : '';
                    let fastTag = item.type === 'fast' ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-500/10 text-amber-500 border border-amber-500/20">${UI['status.fast']}</span>` : '';

                    html += `
                        <div class="group flex items-center justify-between p-4 rounded-xl bg-[#1c1f27] border border-[#282e39] hover:border-[#3b4354] transition-all">
                            <div class="flex items-center gap-4">
                                <div class="flex flex-col items-center justify-center h-10 w-14 rounded-lg bg-[#111318] border border-[#282e39] text-white font-mono font-bold text-lg group-hover:text-primary transition-colors">
                                    ${item.time}
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    ${fastTag}
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-[#282e39] text-white border border-[#3b4354]">$${fare}</span>
                                </div>
                            </div>
                            <div class="text-right">
                                ${tags}
                                ${remark}
                            </div>
                        </div>
                    `;
                }
            });

            scheduleListContainer.innerHTML = html;
            filteredCount.innerText = `${count} departures`;
        }

        function filterSchedule(dateStr) {
            const dateObj = new Date(dateStr);
            const category = getDayCategory(dateObj);

            if (category === 'sun_ph') {
                scheduleStatus.innerText = IS_EN ? "Sunday & Holiday Schedule" : "週日及假期時間表";
                scheduleStatus.className = "ml-auto text-xs text-emerald-400 font-bold whitespace-nowrap";
                if(fareWeekday) fareWeekday.style.opacity = '0.4';
                if(fareHoliday) fareHoliday.style.opacity = '1.0';
            } else if (category === 'sat') {
                scheduleStatus.innerText = IS_EN ? "Saturday Schedule" : "週六時間表";
                scheduleStatus.className = "ml-auto text-xs text-orange-400 font-bold whitespace-nowrap";
                if(fareWeekday) fareWeekday.style.opacity = '1.0';
                if(fareHoliday) fareHoliday.style.opacity = '0.4';
            } else {
                scheduleStatus.innerText = IS_EN ? "Weekday Schedule" : "平日時間表";
                scheduleStatus.className = "ml-auto text-xs text-[#9da6b9] font-medium whitespace-nowrap";
                if(fareWeekday) fareWeekday.style.opacity = '1.0';
                if(fareHoliday) fareHoliday.style.opacity = '0.4';
            }

            renderList(category);
        }

        btnToday.addEventListener('click', () => {
            const today = new Date();
            const todayStr = today.toISOString().split('T')[0];
            datePicker.value = todayStr;
            btnToday.classList.remove('bg-[#282e39]', 'text-[#9da6b9]', 'border-transparent');
            btnToday.classList.add('bg-[#135bec]', 'text-white', 'border-[#135bec]');
            filterSchedule(todayStr);
        });

        datePicker.addEventListener('change', (e) => {
            const val = e.target.value;
            if(!val) return;
            const todayStr = new Date().toISOString().split('T')[0];
            if (val !== todayStr) {
                btnToday.classList.remove('bg-[#135bec]', 'text-white', 'border-[#135bec]');
                btnToday.classList.add('bg-[#282e39]', 'text-[#9da6b9]', 'border-transparent');
            } else {
                btnToday.classList.remove('bg-[#282e39]', 'text-[#9da6b9]', 'border-transparent');
                btnToday.classList.add('bg-[#135bec]', 'text-white', 'border-[#135bec]');
            }
            filterSchedule(val);
        });

        const initToday = new Date();
        const initStr = initToday.toISOString().split('T')[0];
        datePicker.value = initStr;
        filterSchedule(initStr);
    </script>
</body>
</html>